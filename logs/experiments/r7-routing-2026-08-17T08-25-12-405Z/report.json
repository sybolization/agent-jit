          "arguments": {
            "source": "repos = github.search_repositories(query=\"agent framework\", limit=30)\ndetails = repos.map(repo => github.get_repository(full_name=repo.full_name))\nscored = details.map(detail => {\n  ratio = detail.forks / detail.stars\n  if ratio > 0.15:\n    score = github.get_contributor_stats(full_name=detail.full_name).score\n  else:\n    score = github.list_commits(full_name=detail.full_name).score\n  return {full_name: detail.full_name, score: score}\n})\nfiltered = scored.filter(item => item.score >= 100)\nsorted = filtered.sort_desc(item => item.score)\ntop3 = sorted.take(3)\ntop3.map(item => item.full_name)"
          }
        },
