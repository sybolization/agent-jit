{
  "name": "agent-jit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent JIT: a compiler/runtime that offloads deterministic execution paths from LLM agent loops.",
  "license": "MIT",
  "main": "dist/integrations/dsh/index.js",
  "exports": {
    "./dsh": {
      "types": "./dist/integrations/dsh/index.d.ts",
      "default": "./dist/integrations/dsh/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "experiment": "tsx src/experiments/dslGenerationExperiment.ts",
    "experiment:r5": "tsx src/experiments/r5OffloadingBenchmark.ts",
    "experiment:r5-reasoning": "tsx src/experiments/r5ReasoningBenchmark.ts",
    "experiment:r5-reasoning-validity": "tsx src/experiments/r5ReasoningBenchmark.ts --mode=validity",
    "experiment:r5-token-profile": "tsx src/experiments/r5TokenProfile.ts",
    "experiment:r6": "tsx src/experiments/r6DescribeBenchmark.ts",
    "experiment:r6-output-contract": "tsx src/experiments/r6OutputContractBenchmark.ts",
    "experiment:r6-eager-signature": "tsx src/experiments/r6EagerSignatureBenchmark.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-agent-core": "^0.84.0",
    "typebox": "^1.3.11"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "devDependencies": {
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@deepseek-ai/cordis": "file:../workbench/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-tools": "file:../workbench/deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-llm": "file:../workbench/deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-system-prompt": "file:../workbench/deepseek-harness/packages/core/system-prompt",
    "@deepseek-ai/cordis-plugin-timer": "file:../workbench/deepseek-harness/vendor/timer"
  }
}
